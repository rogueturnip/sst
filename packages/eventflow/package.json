{
  "name": "@sst-community/eventflow",
  "description": "Event-driven durable functions with an API shaped like Inngest's, on AWS Lambda durable functions. The runtime of SST's EventFlow component.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sst-community/sst.git",
    "directory": "packages/eventflow"
  },
  "keywords": [
    "sst",
    "eventflow",
    "durable-functions",
    "workflow",
    "inngest"
  ],
  "bugs": "https://github.com/sst-community/sst/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "./scripts/test.sh",
    "test:node": "npm run build && node test/node/order.mjs",
    "test:table": "./scripts/test-table.sh"
  },
  "peerDependencies": {
    "sst": "*"
  },
  "dependencies": {
    "@aws/durable-execution-sdk-js": "2.6.0",
    "aws4fetch": "1.0.18"
  },
  "devDependencies": {
    "@aws/durable-execution-sdk-js-testing": "1.3.0",
    "@types/aws-lambda": "8.10.155",
    "@types/bun": "1.3.0",
    "@types/node": "22.10.0",
    "sst": "npm:@sst-community/sst@4.26.0",
    "typescript": "5.7.2",
    "zod": "3.24.2"
  }
}
